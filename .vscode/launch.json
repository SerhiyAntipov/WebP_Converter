{
    "version": "0.2.0",

    "configurations": [
        {
            "name": "Run Python",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/app.py",
            "console": "integratedTerminal"
        },
        {
            "name": "Debug JavaScript",
            "type": "chrome",
            "request": "launch",
            "url": "http://127.0.0.1:5000",
            "preLaunchTask": "Wait for Flask"
        }
    ],

    "compounds": [
        {
            "name": "Run & Debug",
            "configurations": [
                "Run Python",
                "Debug JavaScript"
            ]
        }
    ]
}
