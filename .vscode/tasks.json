{
    "version": "2.0.0",

    "tasks": [
        {
            "label": "Wait for Flask",
            "type": "shell",
            "command": "while (-not (Test-NetConnection 127.0.0.1 -Port 5000 -InformationLevel Quiet)) { Start-Sleep -Milliseconds 200 }",
            "options": {
                "shell": {
                    "executable": "powershell.exe",
                    "args": [
                        "-NoProfile",
                        "-Command"
                    ]
                }
            },
            "problemMatcher": []
        }
    ]
}